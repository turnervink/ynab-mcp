# Copy to .env and fill in. Never commit .env.

# --- YNAB ---
# https://app.ynab.com/settings/developer -> New Token
YNAB_ACCESS_TOKEN=
# Plan (budget) used when a tool isn't given one: a plan UUID or "last-used"
YNAB_DEFAULT_PLAN_ID=last-used

# --- Public URL (your Cloudflare Tunnel hostname, no trailing slash) ---
BASE_URL=https://ynab-mcp.example.com

# --- GitHub OAuth App (https://github.com/settings/developers) ---
# Authorization callback URL: ${BASE_URL}/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Only these GitHub usernames may use the server (comma-separated)
ALLOWED_GITHUB_LOGINS=

# Signs FastMCP-issued tokens and encrypts stored OAuth state. Generate with:
#   openssl rand -hex 32
# Changing it logs out every client.
JWT_SIGNING_KEY=

# Optional: override which MCP client redirect URIs may register (comma-separated).
# Defaults to Claude's connector callback plus localhost.
# ALLOWED_CLIENT_REDIRECT_URIS=

# --- Cloudflare Tunnel (used by compose.yaml) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Local development only ---
# AUTH_DISABLED=true
